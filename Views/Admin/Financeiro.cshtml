@model FinanceiroViewModel
@{ ViewData["Title"]="Financeiro"; }
<section class="container admin-shell"><div class="admin-title"><span class="mini-label">GESTÃO FINANCEIRA</span><h1>Fluxo de caixa<span class="heading-dot">.</span></h1><p>Vendas confirmadas entram no caixa automaticamente; lance despesas e receitas avulsas abaixo.</p></div><partial name="_AdminNav" />
 <div class="admin-kpis"><div class="kpi"><span>Faturamento de vendas</span><strong>@Model.Resumo.Faturamento.ToString("C")</strong></div><div class="kpi"><span>Despesas / saídas</span><strong>@Model.Resumo.SaidasCaixa.ToString("C")</strong></div><div class="kpi"><span>Saldo de caixa</span><strong>@Model.Resumo.SaldoCaixa.ToString("C")</strong></div></div>
 <div class="admin-panel"><h2>Novo lançamento manual</h2><form asp-action="LancarCaixa" method="post" class="admin-form">@Html.AntiForgeryToken()
 <div class="form-grid"><div class="field"><label asp-for="NovoLancamento.Tipo">Tipo</label><select asp-for="NovoLancamento.Tipo"><option value="ENTRADA">Entrada</option><option value="SAIDA">Saída</option></select></div>
 <div class="field"><label asp-for="NovoLancamento.Valor">Valor (R$)</label><input asp-for="NovoLancamento.Valor" type="number" min="0.01" step="0.01" required /></div></div>
 <div class="field"><label asp-for="NovoLancamento.Descricao">Descrição</label><input asp-for="NovoLancamento.Descricao" maxlength="220" required placeholder="Ex.: pagamento de fornecedor" /></div>
 <button class="btn-primary" type="submit">Salvar lançamento ↗</button></form></div>
 <div class="admin-panel"><h2>Participação nas vendas</h2><div class="table-wrap"><table class="admin-table"><thead><tr><th>Produto</th><th>Quantidade vendida</th><th>% das unidades</th></tr></thead><tbody>
 @foreach(var p in Model.Participacoes){<tr><td>@p.Produto</td><td>@p.Unidades</td><td>@p.Percentual.ToString("N2")%</td></tr>}
 </tbody></table></div></div>
 <div class="admin-panel"><h2>Movimentações de caixa</h2><div class="table-wrap"><table class="admin-table"><thead><tr><th>Data</th><th>Tipo</th><th>Origem</th><th>Descrição</th><th>Valor</th></tr></thead><tbody>
 @foreach(var m in Model.Movimentos){<tr><td>@m.Data.ToString("dd/MM/yyyy HH:mm")</td><td>@m.Tipo</td><td>@m.Origem</td><td>@m.Descricao</td><td>@m.Valor.ToString("C")</td></tr>}
 </tbody></table></div></div>
</section>
