@model Produto
@{
    ViewData["Title"] = Model.Nome;
}
<div class="container breadcrumb"><a asp-controller="Home" asp-action="Index">Início</a><span>›</span><a asp-controller="Produtos" asp-action="Categoria" asp-route-categoria="@Model.Categoria.ToLowerInvariant()">@Model.Categoria</a><span>›</span><span>@Model.Nome</span></div>
<section class="container detail-page"><div class="detail-art"><img src="@Model.Imagem" alt="Ilustração de @Model.Nome" onerror="this.src='/images/placeholder.svg'" /></div><div class="detail-copy"><span class="mini-label">@Model.Categoria.ToUpperInvariant()</span><h1>@Model.Nome</h1><div class="detail-divider"></div><p>@Model.Descricao</p><span class="product-price big-price">@Model.Preco.ToString("C")</span>@if (!OrigemDados.UsarMySql(Config)) { <p class="detail-note">Preço ilustrativo — não corresponde a uma oferta real.</p> }@if(Model.Categoria != "Cigarros" && Model.Estoque > 0) { <a class="btn-primary" asp-controller="Pedidos" asp-action="Novo" asp-route-id="@Model.Id">Solicitar pedido direto ↗</a> } else { <p class="detail-note">Pedido online indisponível para este item.</p> }<button type="button" class="btn-outline" disabled>Adicionar ao carrinho · Futuro</button><a class="back-link" asp-controller="Produtos" asp-action="Categoria" asp-route-categoria="@Model.Categoria.ToLowerInvariant()">← Voltar para @Model.Categoria</a></div></section>
